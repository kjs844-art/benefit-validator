# 남은혜택 환경변수 예시 — 실제 비밀값을 이 파일에 넣지 마세요.
# 로컬에서는 이 파일을 .env 로 복사한 뒤 값을 채웁니다.

# --- 브라우저에 노출되는 값 (공개되어도 안전) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# --- 서버에서만 사용 (VITE_ 접두사 금지) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# 서비스 롤 키: RLS 를 우회합니다. 절대 브라우저로 보내지 마세요.
# 이 앱에서는 AI 호출 한도 기록(consume_ai_quota)에만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# AI 호출 키. Lovable AI Gateway 사용 시 Lovable 이 자동 주입합니다.
# 다른 AI 제공자로 옮기면 이 값 대신 해당 제공자의 키를 사용하세요.
LOVABLE_API_KEY=YOUR_AI_GATEWAY_KEY

# Gmail App User Connector. Lovable에서 클라이언트를 연결하면 서버에 자동 주입됩니다.
# Google OAuth 웹 클라이언트에는 아래 Redirect URI를 등록해야 합니다.
# https://connector-gateway.lovable.dev/api/v1/app-users/oauth2/callback
GOOGLE_MAIL_APP_USER_CONNECTOR_CLIENT_API_KEY=YOUR_CONNECTOR_CLIENT_KEY

# 사용자별 Gmail 연결 키 암호화용 32바이트 base64 비밀값.
# Lovable App User Connector 연결 시 자동 주입되며 브라우저에 노출하면 안 됩니다.
APP_USER_CONNECTION_KEY_SECRET=YOUR_BASE64_ENCRYPTION_KEY
